{
  "manifest_version": 3,
  "name": "Prime Auto Skip + Netflix Intro",
  "version": "1.7.0",
  "description": "Skips Prime Video ads and intros, and automatically clicks Skip Intro on Netflix.",
  "content_scripts": [
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://primevideo.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.in/gp/video/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://netflix.com/*"
      ],
      "js": ["netflix-intro.js"],
      "run_at": "document_idle"
    }
  ]
}
